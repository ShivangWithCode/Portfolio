# Shivang Pandey Portfolio - Environment Configuration
# Copy this file to .env for local development

# Secret key to view/delete inquiries from /api/inquiries or terminal
ADMIN_SECRET_KEY=shivang-admin-key

# Optional: Instant Telegram Notification Bot (100% Free)
# 1. Create a bot with @BotFather on Telegram to get your TELEGRAM_BOT_TOKEN
# 2. Get your personal CHAT_ID from @userinfobot on Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
